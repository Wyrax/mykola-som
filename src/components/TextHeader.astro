---
interface Epigraph {
  text: string;
  source?: string;
}

interface Props {
  title: string;
  untitled?: boolean;
  subtitle?: string;
  dedication?: string;
  epigraph?: string;
  epigraphSource?: string;
  /** Кілька епіграфів; якщо задано, epigraph/epigraphSource не використовуються. */
  epigraphs?: Epigraph[];
  bookTitle: string;
  bookHref: string;
}

const { title, untitled, subtitle, dedication, epigraph, epigraphSource, epigraphs, bookTitle, bookHref } =
  Astro.props;
const allEpigraphs: Epigraph[] = epigraphs ?? (epigraph ? [{ text: epigraph, source: epigraphSource }] : []);
---

<header class="text-header">
  <p class="text-book" data-pagefind-ignore><a href={bookHref}>{bookTitle}</a></p>
  {
    untitled ? (
      <h1 class="text-title text-title--untitled">
        <span aria-hidden="true">* * *</span>
        <span class="visually-hidden">{title}</span>
      </h1>
    ) : (
      <h1 class="text-title">{title}</h1>
    )
  }
  {subtitle && <p class="text-subtitle">{subtitle}</p>}
  {dedication && <p class="dedication">{dedication}</p>}
  {
    allEpigraphs.map((item) => (
      <blockquote class="epigraph">
        <p>{item.text}</p>
        {item.source && <footer>{item.source}</footer>}
      </blockquote>
    ))
  }
</header>
