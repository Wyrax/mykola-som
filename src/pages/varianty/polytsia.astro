---
/**
 * Варіант 2 «Полиця»: обкладинки стоять на полиці, підписи — під ними.
 * Обкладинки різних пропорцій вирівняні по нижньому краю, як справжні книжки.
 */
import Base from '../../layouts/Base.astro';
import BookCover from '../../components/BookCover.astro';
import VariantNav from '../../components/VariantNav.astro';
import { getLibrary, mainTextCount } from '../../lib/library';
import { plural, TEXT_FORMS } from '../../lib/plural';
import { bookUrl } from '../../lib/urls';
import { SITE } from '../../site';

const library = await getLibrary();
---

<Base title="Варіант головної: полиця" noindex>
  <VariantNav current="polytsia" />
  <section class="hero">
    <h1 class="hero-title">{SITE.author}</h1>
    <p class="hero-tagline">{SITE.tagline}</p>
  </section>
  <section class="shelf-section" aria-labelledby="books-title">
    <h2 id="books-title" class="section-title">Книги</h2>
    <ul class="shelf">
      {
        library.map(({ book, texts }) => (
          <li class="shelf-item">
            <a class="shelf-link" href={bookUrl(book.id)}>
              <span class="shelf-cover">
                <BookCover book={book} sizes="(max-width: 40rem) 40vw, 11rem" />
              </span>
              <span class="shelf-title">{book.data.title}</span>
              <span class="shelf-meta">
                {[book.data.year, plural(mainTextCount(book, texts), TEXT_FORMS[book.data.kind])]
                  .filter(Boolean)
                  .join(' · ')}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .shelf-section {
    max-width: 54rem;
    margin-inline: auto;
    overflow-x: clip;
  }

  .shelf {
    --cover-h: 15rem;
    --gap: 2.5rem;
    list-style: none;
    margin: 0;
    padding: 0 0.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(10.5rem, 40%), 1fr));
    column-gap: var(--gap);
    row-gap: calc(var(--line) * 2);
  }

  .shelf-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    color: var(--text);
    text-decoration: none;
  }

  /* Місце для обкладинки однакової висоти; книжка стоїть на дошці полиці. */
  .shelf-cover {
    position: relative;
    align-self: stretch;
    height: var(--cover-h);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    margin-bottom: 1.6rem;
  }

  .shelf-cover::after {
    content: '';
    position: absolute;
    inset-inline: calc(var(--gap) / -2);
    bottom: -0.65rem;
    height: 0.65rem;
    background: linear-gradient(var(--shelf-top), var(--shelf-bottom));
    box-shadow: 0 8px 10px -8px rgb(0 0 0 / 0.45);
  }

  .shelf-cover :global(.cover) {
    position: relative;
    z-index: 1;
    width: auto;
    max-width: 100%;
    max-height: 100%;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .shelf-cover :global(.cover--blank) {
    height: 100%;
  }

  .shelf-link:hover :global(.cover),
  .shelf-link:focus-visible :global(.cover) {
    transform: translateY(-6px);
  }

  @media (prefers-reduced-motion: reduce) {
    .shelf-cover :global(.cover) {
      transition: none;
    }
  }

  .shelf-title {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .shelf-link:hover .shelf-title {
    color: var(--accent);
  }

  .shelf-meta {
    margin-top: 0.3rem;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 40rem) {
    .shelf {
      --cover-h: 12rem;
      --gap: 1.5rem;
      padding: 0;
    }

    .shelf-title {
      font-size: 1rem;
    }
  }
</style>
