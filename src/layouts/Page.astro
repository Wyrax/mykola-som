---
/** Проста текстова сторінка з Markdown (наприклад, «Про автора»). Блоки ```verse стають віршами. */
import Base from './Base.astro';
import { transformVerseBlocks } from '../lib/verse';

interface Props {
  frontmatter: { title: string; description?: string; current?: 'about' | 'search' };
}

const { frontmatter } = Astro.props;
const html = transformVerseBlocks(await Astro.slots.render('default'));
---

<Base title={frontmatter.title} description={frontmatter.description} current={frontmatter.current}>
  <article class="text">
    <header class="text-header">
      <h1 class="text-title">{frontmatter.title}</h1>
    </header>
    <div class="prose">
      <Fragment set:html={html} />
    </div>
  </article>
</Base>
