---
/** Проста текстова сторінка з Markdown (наприклад, «Про автора»). */
import Base from './Base.astro';

interface Props {
  frontmatter: { title: string; description?: string; current?: 'about' | 'search' };
}

const { frontmatter } = Astro.props;
---

<Base title={frontmatter.title} description={frontmatter.description} current={frontmatter.current}>
  <article class="text">
    <header class="text-header">
      <h1 class="text-title">{frontmatter.title}</h1>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>
