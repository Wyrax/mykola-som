---
import '@fontsource-variable/literata/opsz.css';
import '@fontsource-variable/literata/opsz-italic.css';
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { SITE } from '../site';
import { url } from '../lib/urls';
import { getVisitCount } from '../lib/visitCount';

interface Props {
  title?: string;
  description?: string;
  /** Пункт меню, який підсвічується як поточний. */
  current?: 'about' | 'search';
  /** Не індексувати сторінку пошуковиками (сторінка 404). */
  noindex?: boolean;
  /** Повна адреса зображення для прев’ю в соцмережах (обкладинка книги). */
  image?: string;
}

const { title, description = SITE.description, current, noindex = false, image } = Astro.props;
const fullTitle = title ? `${title} — ${SITE.title}` : `${SITE.title}. ${SITE.tagline}`;

// Канонічна адреса: повний URL сторінки, завжди з кінцевою «/», як у карті сайту.
const { pathname } = Astro.url;
const canonicalPath = pathname.endsWith('/') || /\.\w+$/.test(pathname) ? pathname : `${pathname}/`;
const canonical = Astro.site && !noindex ? new URL(canonicalPath, Astro.site).href : undefined;

// Прев’ю в соцмережах: обкладинка книги, а де її немає (головна, «Про автора», пошук) —
// картка 1200×630 з малюнком і підписом (public/images/og-preview.jpg; формат, який Фейсбук не обрізає).
const defaultShareImage = Astro.site ? new URL(url('images/og-preview.jpg'), Astro.site).href : undefined;
const shareImage = image ?? defaultShareImage;
const isDefaultShareImage = !image && Boolean(defaultShareImage);

const visitCount = await getVisitCount();
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="uk_UA" />
    {canonical && <meta property="og:url" content={canonical} />}
    {shareImage && <meta property="og:image" content={shareImage} />}
    {
      isDefaultShareImage && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content="Микола Сом: малюнок і підпис" />
        </>
      )
    }
    {/* велика картинка — лише для альбомної картки; вертикальну обкладинку X (Twitter) обрізав би */}
    <meta name="twitter:card" content={isDefaultShareImage ? 'summary_large_image' : 'summary'} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти до змісту сторінки</a>
    <header class="site-header">
      {/* Підпис «Микола Сом» (SVG як маска, зафарбована кольором тексту — тож він міняється разом
          зі світлою й темною темою); назву сайту читають екранні читачі. */}
      <a class="site-title" href={url()} aria-label={SITE.title}>
        <span
          class="site-signature"
          aria-hidden="true"
          style={`--signature: url('${url('images/mykola-som-signature.svg')}')`}
        ></span>
      </a>
      <nav class="site-nav" aria-label="Головне меню">
        <a href={url('pro-avtora/')} aria-current={current === 'about' ? 'page' : undefined}>Про автора</a>
        <a href={url('poshuk/')} aria-current={current === 'search' ? 'page' : undefined}>Пошук</a>
        <ThemeToggle />
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>{SITE.author}. {SITE.tagline}</p>
      <p>Антон Сом. Сайт</p>
      {/* Сумарні перегляди сайту (GoatCounter), запитані під час збирання сайту — див. lib/visitCount.ts.
          Рядка немає, поки на wyrax.goatcounter.com не ввімкнено «Allow adding visitor counts on your website». */}
      {visitCount && <p class="visit-counter">Переглядів сторінок: {visitCount}</p>}
    </footer>
    <script is:inline>
      // Позначає рядки віршів, що не вмістилися в один рядок екрана (див. .line--wrapped у global.css).
      // ResizeObserver перевіряє їх знову, коли змінюється ширина екрана чи довантажується шрифт.
      (() => {
        const lines = document.querySelectorAll('.verse .line');
        if (!lines.length || !('ResizeObserver' in window)) return;
        const observer = new ResizeObserver((entries) => {
          for (const { target, contentRect } of entries) {
            const lineHeight = parseFloat(getComputedStyle(target).lineHeight);
            target.classList.toggle('line--wrapped', contentRect.height > lineHeight * 1.5);
          }
        });
        lines.forEach((line) => observer.observe(line));
      })();

      // Епіграф стоїть біля правого краю, рядки в ньому вирівняні ліворуч. Коли рядок епіграфа не вміщається
      // і переноситься («Весела Оболонь» на телефоні), браузер лишає блок на всю доступну ширину — і текст
      // відходить від правого краю. Тут ширина тексту стискається до найдовшого рядка (без JS — як було).
      (() => {
        const items = [...document.querySelectorAll('.epigraph p:not(.epigraph-source)')];
        if (!items.length) return;
        const range = document.createRange();
        const fit = () => {
          items.forEach((p) => (p.style.width = ''));
          const widths = items.map((p) => {
            range.selectNodeContents(p);
            const rights = [...range.getClientRects()].filter((r) => r.width > 0).map((r) => r.right);
            return rights.length ? Math.ceil(Math.max(...rights) - p.getBoundingClientRect().left) : 0;
          });
          items.forEach((p, i) => {
            if (widths[i] && widths[i] < p.getBoundingClientRect().width - 1) p.style.width = `${widths[i] + 1}px`;
          });
        };
        fit();
        document.fonts?.ready.then(fit);
        let frame = 0;
        addEventListener('resize', () => {
          cancelAnimationFrame(frame);
          frame = requestAnimationFrame(fit);
        });
      })();
    </script>
    <!-- Лічильник відвідувань (GoatCounter); на localhost і при попередньому перегляді не рахує. -->
    <script data-goatcounter="https://wyrax.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </body>
</html>
