---
import '@fontsource-variable/literata/opsz.css';
import '@fontsource-variable/literata/opsz-italic.css';
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { SITE } from '../site';
import { url } from '../lib/urls';

interface Props {
  title?: string;
  description?: string;
  /** Пункт меню, який підсвічується як поточний. */
  current?: 'about' | 'search';
  /** Не індексувати сторінку пошуковиками (сторінка 404). */
  noindex?: boolean;
  /** Повна адреса зображення для прев’ю в соцмережах (обкладинка книги). */
  image?: string;
}

const { title, description = SITE.description, current, noindex = false, image } = Astro.props;
const fullTitle = title ? `${title} — ${SITE.title}` : `${SITE.title}. ${SITE.tagline}`;

// Канонічна адреса: повний URL сторінки, завжди з кінцевою «/», як у карті сайту.
const { pathname } = Astro.url;
const canonicalPath = pathname.endsWith('/') || /\.\w+$/.test(pathname) ? pathname : `${pathname}/`;
const canonical = Astro.site && !noindex ? new URL(canonicalPath, Astro.site).href : undefined;
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="uk_UA" />
    {canonical && <meta property="og:url" content={canonical} />}
    {image && <meta property="og:image" content={image} />}
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти до змісту сторінки</a>
    <header class="site-header">
      <a class="site-title" href={url()}>{SITE.title}</a>
      <nav class="site-nav" aria-label="Головне меню">
        <a href={url('pro-avtora/')} aria-current={current === 'about' ? 'page' : undefined}>Про автора</a>
        <a href={url('poshuk/')} aria-current={current === 'search' ? 'page' : undefined}>Пошук</a>
        <ThemeToggle />
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>{SITE.author}. {SITE.tagline}</p>
    </footer>
    <script is:inline>
      // Позначає рядки віршів, що не вмістилися в один рядок екрана (див. .line--wrapped у global.css).
      // ResizeObserver перевіряє їх знову, коли змінюється ширина екрана чи довантажується шрифт.
      (() => {
        const lines = document.querySelectorAll('.verse .line');
        if (!lines.length || !('ResizeObserver' in window)) return;
        const observer = new ResizeObserver((entries) => {
          for (const { target, contentRect } of entries) {
            const lineHeight = parseFloat(getComputedStyle(target).lineHeight);
            target.classList.toggle('line--wrapped', contentRect.height > lineHeight * 1.5);
          }
        });
        lines.forEach((line) => observer.observe(line));
      })();
    </script>
  </body>
</html>
